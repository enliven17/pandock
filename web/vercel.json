{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/og.ts": { "includeFiles": "node_modules/harfbuzzjs/hb.wasm" }
  },
  "rewrites": [
    { "source": "/r/:code", "destination": "/api/r?code=:code" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
